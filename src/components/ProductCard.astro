---
interface Props {
  url: string;
  title: string;
  tagline?: string;
  description: string;
  price?: string;
  image?: string;
  category: string;
  type: 'template' | 'printable';
  isLive: boolean;
}
const { url, title, tagline, description, price, image, category, type, isLive } = Astro.props;
---

<article class="product-card" data-category={category} data-type={type}>
  <a class="product-card__link" href={url}>
    <div class="product-card__media">
      {image ? (
        <img src={image} alt={title} loading="lazy" width="600" height="600" />
      ) : (
        <div class="product-card__placeholder" aria-hidden="true">
          <span>{isLive ? 'Preview coming soon' : 'In the works'}</span>
        </div>
      )}
      <span class:list={['product-card__badge', isLive ? 'is-live' : 'is-soon']}>
        {isLive ? 'Available now' : 'Coming soon'}
      </span>
    </div>
    <div class="product-card__body">
      <p class="product-card__category">{category}</p>
      <h3>{title}</h3>
      <p class="product-card__text">{tagline ?? description}</p>
      <p class="product-card__foot">
        {isLive && price ? <span>{price}</span> : <span>Preview product</span>}
        <strong>View details →</strong>
      </p>
    </div>
  </a>
</article>

<style>
  .product-card {
    overflow: hidden;
    background: var(--card, #fffdf9);
    border: 1px solid var(--border, #eadfd4);
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(67, 54, 48, 0.04);
    transition: transform .22s ease, box-shadow .22s ease;
  }
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 38px rgba(67, 54, 48, 0.08);
  }
  .product-card__link { display: block; color: inherit; text-decoration: none; }
  .product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(145deg, #f6e7df, #f8f4ef 58%, #eee2d8);
  }
  .product-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .product-card__placeholder {
    width: 100%; height: 100%; display: grid; place-items: center;
    color: var(--muted, #7c6d65); font-size: .86rem; letter-spacing: .08em; text-transform: uppercase;
  }
  .product-card__badge {
    position: absolute; top: .8rem; left: .8rem; padding: .42rem .7rem; border-radius: 999px;
    background: rgba(255,253,249,.94); color: var(--text, #433630); font-size: .72rem; font-weight: 600;
    box-shadow: 0 4px 16px rgba(0,0,0,.05);
  }
  .product-card__badge.is-soon { color: var(--muted, #7c6d65); }
  .product-card__body { padding: 1.3rem 1.35rem 1.45rem; }
  .product-card__category {
    margin: 0 0 .45rem; color: var(--terracotta, #c98362); font-size: .72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .12em;
  }
  .product-card h3 { margin: 0 0 .5rem; font-size: 1.55rem; line-height: 1.08; }
  .product-card__text { margin: 0; font-size: .93rem; line-height: 1.55; }
  .product-card__foot {
    margin: 1rem 0 0; padding-top: .9rem; border-top: 1px solid var(--border, #eadfd4);
    display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; font-size: .88rem;
  }
  .product-card__foot strong { color: var(--text, #433630); font-weight: 600; }
</style>
