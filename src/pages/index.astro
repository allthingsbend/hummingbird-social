---
import Layout from '../layouts/Layout.astro';

const etsyShopUrl = 'https://www.etsy.com/shop/HummingbirdSocial';

const featuredProducts = [
  {
    title: 'Palm Springs Save the Date Card',
    description:
      'A modern Palm Springs save the date featuring your wedding venue and destination details.',
    url: 'https://www.etsy.com/listing/4535297551/palm-springs-save-the-date-card-w-venue',
  },
  {
    title: 'Joshua Tree Wedding Invitation Template',
    description:
      'An editable Joshua Tree wedding invitation template inspired by desert landscapes and modern destination weddings.',
    url: 'https://www.etsy.com/listing/4519847566/joshua-tree-wedding-invitation-template',
  },
];
---

<Layout
  title="Hummingbird Social | Editable Wedding Invitations & Templates"
  description="Shop editable wedding invitation templates, save the dates, bridal shower invitations, printable wedding stationery, and modern downloadable designs from Hummingbird Social."
>
  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Editable wedding templates</p>

          <h1>Modern wedding stationery made simple.</h1>

          <p class="lead">
            Hummingbird Social creates editable wedding invitations, save the
            dates, bridal shower invitations, day-of stationery, and printable
            celebration designs with a soft, romantic, and modern feel.
          </p>

          <div class="button-row">
            <a
              class="button"
              href={etsyShopUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Shop on Etsy
            </a>

            <a class="button secondary" href="/wedding-invitation-suites/">
              Browse Wedding Invitations
            </a>
          </div>
        </div>

        <div class="hero-card">
          <div class="hero-card-inner">
            <p class="eyebrow">Download · Edit · Print</p>

            <h2>
              Beautiful wedding stationery without the custom-design timeline.
            </h2>

            <p>
              Choose a design you love, personalize your wording and event
              details, and print your stationery when you are ready.
            </p>

            <div class="button-row">
              <a class="button" href="/how-it-works/">
                See How It Works
              </a>

              <a class="button secondary" href="/printing-guide/">
                Printing Guide
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Featured designs</p>

        <h2>Start with our latest wedding templates.</h2>

        <div class="grid">
          {
            featuredProducts.map((product) => (
              <a
                class="card"
                href={product.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <h3>{product.title}</h3>

                <p>{product.description}</p>

                <p>
                  <strong>View on Etsy →</strong>
                </p>
              </a>
            ))
          }

          <a
            class="card"
            href={etsyShopUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <h3>Shop All Designs</h3>

            <p>
              Explore the complete Hummingbird Social Etsy shop for editable
              wedding invitations, save the dates, and new stationery designs.
            </p>

            <p>
              <strong>Visit the Etsy Shop →</strong>
            </p>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Shop by category</p>

        <h2>Wedding templates for every little detail.</h2>

        <div class="grid">
          <a class="card" href="/wedding-invitation-suites/">
            <h3>Wedding Invitation Suites</h3>

            <p>
              Editable invitation templates with matching RSVP cards, detail
              cards, and coordinated stationery for modern weddings.
            </p>
          </a>

          <a class="card" href="/bridal-shower-invitations/">
            <h3>Bridal Shower Invitations</h3>

            <p>
              Pretty, easy-to-edit bridal shower invitation templates for
              brunches, garden parties, intimate gatherings, and stylish
              celebrations.
            </p>
          </a>

          <a class="card" href="/custom-design-requests/">
            <h3>Custom Design Requests</h3>

            <p>
              Need a matching sign, menu, thank you card, or custom layout?
              Request a coordinated design in the Hummingbird Social style.
            </p>
          </a>
        </div>
      </div>
    </section>

    <section class="feature-band">
      <div class="container content">
        <p class="eyebrow">Why digital templates?</p>

        <h2>Download, edit, print, and celebrate.</h2>

        <p>
          Digital templates give you the flexibility to create beautiful wedding
          stationery without waiting on a fully custom design process. Choose a
          design you love, personalize the wording, update your event details,
          and print when you are ready.
        </p>

        <p>
          Every Hummingbird Social template is designed to feel polished and
          intentional while still being simple enough for real-life wedding
          planning.
        </p>

        <div class="button-row">
          <a
            class="button"
            href={etsyShopUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Shop on Etsy
          </a>

          <a class="button secondary" href="/how-it-works/">
            How It Works
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Helpful planning guides</p>

        <h2>Everything you need to feel confident before you print.</h2>

        <div class="grid">
          <a class="card" href="/how-it-works/">
            <h3>How It Works</h3>

            <p>
              Learn how editable templates work, what happens after purchase,
              how to customize your design, and how to download your files.
            </p>
          </a>

          <a class="card" href="/printing-guide/">
            <h3>Wedding Printing Guide</h3>

            <p>
              Find simple guidance on cardstock, paper finishes, envelope
              sizes, online printers, local print shops, and home printing.
            </p>
          </a>

          <a class="card" href="/wording-etiquette/">
            <h3>Wording & Etiquette</h3>

            <p>
              Find wording ideas for adult-only weddings, cash bars,
              micro-weddings, elopements, family situations, and more.
            </p>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container content">
        <p class="eyebrow">Our style</p>

        <h2>Soft romance, clean typography, and thoughtful details.</h2>

        <p>
          Hummingbird Social is for couples and hosts who want stationery that
          feels elevated but approachable. Our designs blend warm neutrals,
          romantic details, vintage-inspired touches, modern layouts, and
          polished typography.
        </p>

        <p>
          From the first save the date to the final thank you card, each piece is
          created to help your event feel cohesive, beautiful, and easy to pull
          together.
        </p>

        <div class="button-row">
          <a class="button" href="/about/">
            About Hummingbird Social
          </a>

          <a
            class="button secondary"
            href={etsyShopUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit Our Etsy Shop
          </a>
        </div>
      </div>
    </section>

    <section class="feature-band">
      <div class="container">
        <p class="eyebrow">Popular template needs</p>

        <h2>Start with the piece you need most.</h2>

        <div class="grid">
          <a class="card" href="/wedding-invitation-suites/">
            <h3>Wedding Invitations</h3>

            <p>
              Editable invitation suites for formal weddings, intimate
              celebrations, destination weddings, and modern events.
            </p>
          </a>

          <a class="card" href="/bridal-shower-invitations/">
            <h3>Bridal Shower Invitations</h3>

            <p>
              Printable shower invitations for garden parties, brunch showers,
              modern bridal celebrations, and hosted gatherings.
            </p>
          </a>

          <a class="card" href="/custom-design-requests/">
            <h3>Matching Stationery</h3>

            <p>
              Request matching menus, signs, place cards, thank you cards, or
              coordinated day-of pieces for your celebration.
            </p>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container content">
        <p class="eyebrow">Questions before you order?</p>

        <h2>Planning should feel easier, not more confusing.</h2>

        <p>
          Not sure how editable templates work, what paper to choose, or whether
          a design can be adjusted for your event? Start with our support pages
          or reach out with your question.
        </p>

        <div class="button-row">
          <a class="button" href="/faq/">
            View Common Questions
          </a>

          <a class="button secondary" href="/contact/">
            Contact Hummingbird Social
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
