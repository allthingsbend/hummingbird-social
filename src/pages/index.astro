---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { allProducts, resolve } from '../lib/products';

const products = (await allProducts()).map(resolve);
const liveProducts = products.filter((p) => p.isLive).slice(0, 4);
const etsyShopUrl = 'https://hummingbirdsocial.etsy.com';
---

<Layout title="Hummingbird Social Studio | Wedding Templates & Digital Printables" description="Shop editable wedding invitation templates, save the dates and thoughtful printable planners from Hummingbird Social Studio. Browse on our site and check out securely on Etsy.">
  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Digital designs by Hummingbird Social Studio</p>
          <h1>Thoughtful designs for celebrations and real life.</h1>
          <p class="lead">
            Editable wedding invitations and save the dates, plus a growing collection of printable planners, journals and checklists.
            Browse everything here, then complete purchases securely through Etsy.
          </p>
          <div class="button-row"><a class="button" href="/shop/">Shop Hummingbird Social</a><a class="button secondary" href="/wedding-invitation-suites/">Browse Wedding Invitations</a></div>
        </div>
        <div class="hero-card">
          <div class="hero-card-inner">
            <p class="eyebrow">Simple by design</p>
            <h2>{liveProducts.length} designs available now — with more in the works.</h2>
            <p>Wedding templates are editable in Canva. New printables are being built as ready-to-use digital planning tools.</p>
            <div class="button-row"><a class="button" href="/shop/">See the Shop</a><a class="button secondary" href="/printables/">Preview Printables</a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Available now</p>
        <h2>Shop the current Etsy collection.</h2>
        <p class="lead home-intro">See the product details here first. When you are ready to buy, the checkout opens in the Hummingbird Social Etsy shop.</p>
        <div class="home-shop-grid">
          {liveProducts.map((p) => <ProductCard url={p.url} title={p.title} tagline={p.tagline} description={p.description} price={p.price} image={p.images[0]} category={p.category} type={p.type} isLive={p.isLive} />)}
        </div>
        <div class="button-row"><a class="button" href="/shop/">Browse the Full Shop</a><a class="button secondary" href={etsyShopUrl} target="_blank" rel="noopener noreferrer">Visit Etsy</a></div>
      </div>
    </section>

    <section class="feature-band">
      <div class="container">
        <p class="eyebrow">Shop your way</p>
        <h2>Wedding stationery now. More printable life tools next.</h2>
        <div class="grid">
          <a class="card" href="/wedding-invitation-suites/"><h3>Wedding Invitations</h3><p>Editable invitation and save-the-date designs with hand-drawn destination and venue details.</p><strong>Browse wedding designs →</strong></a>
          <a class="card" href="/printables/"><h3>Printable Planners</h3><p>Preview the growing collection of wedding, pregnancy, postpartum, home and organization printables.</p><strong>Explore printables →</strong></a>
          <a class="card" href="/how-it-works/"><h3>How It Works</h3><p>Understand what you receive, how Canva templates work, and the easiest ways to download and print.</p><strong>See the process →</strong></a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container content">
        <p class="eyebrow">Made to feel personal</p>
        <h2>Soft romance, clean typography and thoughtful details.</h2>
        <p>Hummingbird Social is for people who want digital designs that feel elevated without making the process complicated. Wedding pieces mix original hand-drawn artwork with simple typography; the printable collection carries that same calm, useful approach into planning and everyday life.</p>
        <div class="button-row"><a class="button" href="/about/">About Hummingbird Social</a><a class="button secondary" href="/custom-design-requests/">Custom Design Requests</a></div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Helpful before you print</p>
        <h2>Guides for the details that come after choosing a design.</h2>
        <div class="grid">
          <a class="card" href="/printing-guide/"><h3>Printing Guide</h3><p>Cardstock, paper finishes, envelope sizes, online printers, local print shops and home printing.</p></a>
          <a class="card" href="/wording-etiquette/"><h3>Wording &amp; Etiquette</h3><p>Invitation wording ideas for adult-only weddings, cash bars, intimate celebrations and more.</p></a>
          <a class="card" href="/faq/"><h3>Common Questions</h3><p>Answers about editing, downloading, printing, digital products and custom requests.</p></a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .home-shop-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-top: 2rem; }
  .home-intro { max-width: 48rem; }
  .feature-band .card strong { display: inline-block; margin-top: .75rem; color: var(--text); }
  @media (max-width: 1050px) { .home-shop-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .home-shop-grid { grid-template-columns: 1fr; } }
</style>
