---
import Layout from '../../layouts/Layout.astro';
import { etsyGuidePages } from '../../data/etsy-guide-pages';
import { ETSY_SHOP } from '../../lib/products';
const title='Digital Planner & Printable Guides | Hummingbird Social Studio';
const description='Browse practical guides for printable planners, party kits, family organizers, creator templates, travel planners and other Hummingbird-style digital downloads.';
---
<Layout title={title} description={description}><main class="hub"><header class="hero"><p class="eyebrow">Digital download ideas</p><h1>Useful printable and template guides for real-life projects.</h1><p>Explore planning ideas inspired by the Hummingbird Social Studio collection, from moving and group trips to dinner parties, family organizers, creator tools and seasonal printables.</p><div class="actions"><a class="button" href={ETSY_SHOP} target="_blank" rel="noopener noreferrer">Shop Hummingbird on Etsy</a><a class="button secondary" href="/printables/">Pregnancy & wedding printables</a></div></header><section class="grid">{etsyGuidePages.map((page)=><a class="card" href={`/digital-downloads/${page.slug}/`}><span>{page.eyebrow}</span><h2>{page.h1}</h2><p>{page.description}</p><strong>Read the guide →</strong></a>)}</section></main></Layout>
<style>.hub{width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:2rem 0 6rem}.hero{max-width:920px;padding:clamp(2.5rem,6vw,5rem) 0 3rem}.hero h1{max-width:900px;margin:.4rem 0 1rem;font-size:clamp(3.4rem,7vw,6.2rem);line-height:.92}.hero>p:not(.eyebrow){max-width:760px;font-size:1.12rem;line-height:1.75}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding-top:1.5rem}.card{padding:1.6rem;background:#fffdf9;border:1px solid var(--border);border-radius:20px;transition:transform .2s ease,box-shadow .2s ease}.card:hover{transform:translateY(-3px);box-shadow:var(--shadow-soft)}.card span{color:var(--terracotta);font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.14em}.card h2{margin:.55rem 0 .75rem;font-size:2rem;line-height:1.02}.card p{font-size:.92rem;line-height:1.65}.card strong{display:inline-block;margin-top:.35rem}@media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.hub{width:min(100% - 1.5rem,1180px)}.grid{grid-template-columns:1fr}}</style>
