---
import Layout from '../../layouts/Layout.astro';
import { etsyGuidePages } from '../../data/etsy-guide-pages';
import { supportGuides } from '../../data/support-guides';
import { ETSY_SHOP, SITE } from '../../lib/products';
export function getStaticPaths(){return etsyGuidePages.map((page)=>({params:{slug:page.slug},props:{page}}));}
const { page }=Astro.props;
const related=etsyGuidePages.filter((item)=>item.slug!==page.slug).slice(0,3);
const helpfulGuides=supportGuides.filter((guide)=>guide.relatedDownload===page.slug);
const canonical=`${SITE}/digital-downloads/${page.slug}/`;
const faqList=[page.faq,{q:'Can I print a digital planner or template at home?',a:'If the specific product is sold as a printable PDF, it can typically be printed at home or through a print service. Always follow the file instructions for that download.'},{q:'Can I reprint a Hummingbird digital download?',a:'Personal-use digital products can often be reprinted for your own use, but the license included with the specific product controls what is allowed.'}];
const webPageSchema={'@context':'https://schema.org','@type':'WebPage',name:page.title,description:page.description,url:canonical,isPartOf:{'@type':'WebSite',name:'Hummingbird Social Studio',url:SITE}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqList.map((faq)=>({'@type':'Question',name:faq.q,acceptedAnswer:{'@type':'Answer',text:faq.a}}))};
const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE}/`},{'@type':'ListItem',position:2,name:'Digital Downloads',item:`${SITE}/digital-downloads/`},{'@type':'ListItem',position:3,name:page.h1,item:canonical}]};
---
<Layout title={page.title} description={page.description}>
<link rel="canonical" href={canonical} slot="head" /><script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} is:inline slot="head" /><script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline slot="head" /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline slot="head" />
<main class="guide"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/digital-downloads/">Digital Downloads</a><span>/</span><span>{page.eyebrow}</span></nav>
<header class="hero"><div><p class="eyebrow">{page.eyebrow}</p><h1>{page.h1}</h1><p class="lead">{page.intro}</p><div class="actions"><a class="button" href={ETSY_SHOP} target="_blank" rel="noopener noreferrer">Shop Hummingbird on Etsy</a><a class="button secondary" href="/guides/">Browse practical guides</a></div></div><aside class="hero-card"><span>Hummingbird Social Studio</span><strong>Useful first.<br/>Pretty too.</strong><p>Digital planners, printables and templates made to make real-life projects easier to organize.</p></aside></header>
<div class="content-grid"><article><section class="section"><p class="section-no">01</p><h2>What to include in a useful version.</h2><p>The best digital download is the one that helps with the real decisions, lists and details behind the project. For this kind of planner or template, these are the pieces worth prioritizing:</p><ul>{page.items.map((item)=><li>{item}</li>)}</ul></section><section class="section"><p class="section-no">02</p><h2>How to use it without overcomplicating things.</h2><p>{page.howTo}</p></section><section class="section"><p class="section-no">03</p><h2>One simple way to make it more useful.</h2><p>{page.tip}</p></section>
{helpfulGuides.length>0&&<section class="howto"><p class="eyebrow">Go deeper</p><h2>Practical how-to guides for this project.</h2><p>These are standalone planning guides with timelines, systems and checklists you can use even if you never buy a printable.</p><div class="howto-grid">{helpfulGuides.map((guide)=><a href={`/guides/${guide.slug}/`}><strong>{guide.h1}</strong><span>{guide.description}</span><b>Read the guide →</b></a>)}</div></section>}
<section class="etsy-cta"><p class="eyebrow">Current Hummingbird downloads</p><h2>See what is live in the Etsy shop.</h2><p>These guides are built around the kinds of planners, kits and templates Hummingbird Social Studio creates. Product availability changes as new designs are finished, so Etsy is the best place to see what can be purchased right now.</p><a class="button" href={ETSY_SHOP} target="_blank" rel="noopener noreferrer">Browse the Etsy Shop</a></section>
<section class="faq"><p class="eyebrow">Common questions</p><h2>Before you print or plan.</h2>{faqList.map((faq)=><details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</section></article><aside class="side"><div class="side-card"><p class="eyebrow">Why this page exists</p><h3>Start with the useful part.</h3><p>Each guide explains what to look for in this kind of digital product before sending you to the current Etsy collection.</p><a href="/guides/">Read practical how-to guides →</a></div></aside></div>
<section class="related"><div class="related-head"><div><p class="eyebrow">More ideas</p><h2>Related digital download guides.</h2></div><a href="/digital-downloads/">View all guides →</a></div><div class="cards">{related.map((item)=><a class="card" href={`/digital-downloads/${item.slug}/`}><span>{item.eyebrow}</span><h3>{item.h1}</h3><p>{item.description}</p><strong>Read the guide →</strong></a>)}</div></section></main>
</Layout>
<style>.guide{width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:1.4rem 0 6rem}.crumbs{display:flex;flex-wrap:wrap;gap:.45rem;padding:.5rem .2rem 1.35rem;color:var(--muted);font-size:.82rem}.hero{display:grid;grid-template-columns:1.25fr .55fr;gap:clamp(2rem,5vw,5rem);align-items:center;padding:clamp(3rem,6vw,5.5rem);background:radial-gradient(circle at 90% 10%,rgba(127,141,115,.16),transparent 18rem),linear-gradient(135deg,#fff9f2,#f4ddd2);border:1px solid var(--border);border-radius:28px;box-shadow:0 24px 60px rgba(77,53,43,.07)}.hero h1{margin:.35rem 0 1rem;font-size:clamp(3.2rem,6vw,5.6rem);line-height:.94;max-width:52rem}.lead{font-size:1.1rem;line-height:1.75;max-width:48rem}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem}.hero-card{padding:2rem;background:#fffdf9;border:1px solid var(--border);border-radius:20px;transform:rotate(2deg);box-shadow:0 24px 44px rgba(68,45,37,.14)}.hero-card span,.card>span{color:var(--terracotta);font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.14em}.hero-card strong{display:block;margin:1rem 0;font-family:'Cormorant Garamond',serif;font-size:2.7rem;line-height:.95}.content-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(2.5rem,6vw,5.5rem);align-items:start;padding:5rem .2rem 0}.section{max-width:48rem;padding-bottom:3.2rem;margin-bottom:3.2rem;border-bottom:1px solid var(--border)}.section-no{color:var(--terracotta);font-weight:700;letter-spacing:.16em;font-size:.72rem}.section h2,.etsy-cta h2,.faq h2,.howto h2{margin:.4rem 0 1rem;font-size:clamp(2.25rem,4vw,3.45rem);line-height:1}.section>p:last-of-type{font-size:1.05rem;line-height:1.8}.section ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem 1rem;padding:0;margin:1.5rem 0 0;list-style:none}.section li{padding:.85rem 1rem;background:#fffdf9;border:1px solid var(--border);border-radius:14px;color:var(--muted)}.howto{max-width:48rem;padding:2.4rem;margin:0 0 4rem;background:#f4f2ea;border:1px solid var(--border);border-radius:24px}.howto>p:not(.eyebrow){max-width:40rem}.howto-grid{display:grid;gap:.8rem;margin-top:1.4rem}.howto-grid a{display:grid;gap:.4rem;padding:1.1rem;background:#fffdf9;border:1px solid var(--border);border-radius:14px}.howto-grid a strong{font-size:1.2rem;color:var(--text)}.howto-grid a span{font-size:.9rem;line-height:1.55;color:var(--muted)}.howto-grid a b{font-size:.85rem;color:var(--terracotta-dark)}.etsy-cta{max-width:48rem;padding:2.6rem;margin:0 0 4rem;background:linear-gradient(135deg,#f5ded2,#efd0c1);border:1px solid #e2c2b1;border-radius:24px}.faq{max-width:48rem}.faq details{padding:1.1rem 0;border-bottom:1px solid var(--border)}.faq summary{cursor:pointer;font-weight:700}.side{position:sticky;top:145px}.side-card{padding:1.5rem;background:#fffdf9;border:1px solid var(--border);border-radius:20px;box-shadow:var(--shadow-soft)}.side-card h3{margin:.3rem 0 .7rem;font-size:2rem}.side-card a{color:var(--terracotta-dark);font-weight:700}.related{margin-top:6rem;padding-top:3.5rem;border-top:1px solid var(--border)}.related-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.7rem}.related-head h2{margin:0}.related-head>a{color:var(--terracotta-dark);font-weight:700}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.card{padding:1.5rem;background:#fffdf9;border:1px solid var(--border);border-radius:20px}.card h3{margin:.55rem 0 .75rem;font-size:1.8rem;line-height:1.02}.card p{font-size:.9rem;line-height:1.6}@media(max-width:900px){.hero,.content-grid{grid-template-columns:1fr}.side{position:static}.hero-card{transform:none}}@media(max-width:680px){.guide{width:min(100% - 1.5rem,1180px)}.hero{padding:3rem 1.4rem}.hero h1{font-size:clamp(3rem,14vw,4.25rem)}.section ul,.cards{grid-template-columns:1fr}.etsy-cta,.howto{padding:1.5rem}.related-head{display:block}}</style>
