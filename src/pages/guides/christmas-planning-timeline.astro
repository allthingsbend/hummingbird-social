---
import StandaloneGuide from '../../components/StandaloneGuide.astro';
const sections = [
  { heading:'October: make decisions before the calendar fills up', body:'October is useful for the choices that affect everything else. You do not need to start celebrating early, but you can decide travel, hosting, gift boundaries and the events you actually want on the calendar before December becomes crowded.', bullets:['Confirm travel dates and overnight guests','Set a total gift budget','Start one master gift list','Decide who is hosting which meals','Note school, work and family events','Order anything custom or slow to ship'] },
  { heading:'November: buy, book and make the plan concrete', body:'November is the month to turn ideas into confirmed plans. Buy the gifts with the most uncertainty first, lock in menus, make reservations and identify anything that requires shipping or advance prep.', bullets:['Purchase hard-to-find gifts first','Finalize holiday card list','Build the main meal or hosting menu','Check serving dishes and extra seating','Schedule shipping deadlines','Choose which traditions are actually happening this year'] },
  { heading:'Early December: finish the work that creates clutter', body:'Aim to have most ordering done before the final two weeks. Wrap gifts as they arrive, address cards in batches and buy shelf-stable hosting supplies before grocery stores and delivery schedules get busier.' },
  { heading:'Final week: protect capacity instead of adding more', body:'The final week should be for fresh groceries, cooking, travel and enjoying what you planned. If a task appears now that was never important enough to plan earlier, it is a good candidate to skip.' }
];
const checklist=['Travel dates confirmed','Gift budget set','Master gift list started','Hosting responsibilities clear','Major gifts ordered','Cards or messages planned','Menu finalized','Wrapping supplies ready','Fresh-food shopping scheduled','One unscheduled evening protected'];
const mistakes=['Treating every tradition as mandatory','Waiting until December to discuss family travel','Tracking gift ideas but not whether items were ordered','Buying decor before checking what you already own','Planning multiple elaborate meals in the same week','Filling every open night with an event'];
const faqs=[{q:'When should I start planning for Christmas?',a:'October is a useful time for travel, budgets and big decisions. November works well for purchasing and confirming plans, leaving December for finishing rather than starting.'},{q:'What should I do before December?',a:'Confirm travel and hosting, set a gift budget, start the gift list, order custom items and note important event dates before the calendar gets crowded.'},{q:'How can I make Christmas less stressful?',a:'Decide priorities early, limit optional commitments, finish ordering ahead of the final weeks and deliberately leave some unscheduled time.'}];
---
<StandaloneGuide slug="christmas-planning-timeline" category="holiday planning" title="Christmas Planning Timeline | October, November & December Checklist" description="A practical Christmas planning timeline for gifts, travel, hosting, cards, meals and December tasks, organized by what to do in October, November and the final weeks." h1="A Christmas planning timeline that moves the busy work out of the final week." intro="Holiday stress usually comes from too many decisions landing at once. A simple timeline helps you make high-leverage choices early, finish shopping and logistics before the final stretch, and leave December with more room for the parts you actually enjoy." quickAnswer="Use October for decisions, November for purchasing and confirmations, early December for wrapping and setup, and the final week for fresh food, travel and only the tasks that truly need to happen then." relatedDownload="christmas-planner-printable" relatedLabel="Christmas Planner Printable" {sections} {checklist} {mistakes} {faqs} relatedGuides={[{href:'/guides/christmas-gift-budget/',label:'How to build a Christmas gift budget'},{href:'/guides/christmas-hosting-checklist/',label:'Christmas hosting checklist'}]} />
