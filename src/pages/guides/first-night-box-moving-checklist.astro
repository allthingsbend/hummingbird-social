---
import StandaloneGuide from '../../components/StandaloneGuide.astro';
const sections = [
  { heading:'Pack for the first 24 hours, not for the whole move', body:'The first-night box is not a miniature version of your house. It is a small set of items that prevents you from opening ten boxes just to shower, charge a phone or make breakfast. Think about what you will actually do between arriving and getting through the next morning.', bullets:['Change of clothes and sleepwear','Toiletries and towels','Phone chargers','Daily medications','Basic breakfast or coffee setup','Paper towels and trash bags','Toilet paper','Pet or baby essentials if relevant'] },
  { heading:'Keep documents, valuables and medication with you', body:'Some things should not be buried in a moving truck at all. Identification, keys, wallets, medication, closing or lease paperwork, small valuables and critical electronics should travel with you in a backpack or clearly controlled bag.' },
  { heading:'Build one household essentials box', body:'Separate personal overnight bags from a shared household box. That box can hold the simple tools and supplies that make the new place functional while most boxes are still closed.', bullets:['Box cutter or scissors','Multi-bit screwdriver','Trash bags','Cleaning spray and cloths','Paper towels','Hand soap','A few cups, plates and utensils','Coffee maker or kettle if it matters to you'] },
  { heading:'Load it last so it comes off first', body:'A perfectly packed essentials box is useless if it is behind a sofa at the front of the truck. Mark it OPEN FIRST, keep it near the truck door, or transport it in your own vehicle if space allows.' }
];
const checklist=['Overnight clothes','Toiletries','Towels','Medications','Chargers','Important documents','Keys and wallet','Toilet paper','Trash bags','Cleaning basics','Scissors or box cutter','Breakfast or coffee basics'];
const mistakes=['Packing medication in a random bedroom box','Putting the essentials box deep in the truck','Trying to include everything you might need for a week','Forgetting towels or toilet paper','Packing every charger with electronics','Mixing important documents into ordinary paperwork boxes'];
const faqs=[{q:'What should go in a first-night moving box?',a:'Pack toiletries, towels, chargers, medication, basic cleaning supplies, toilet paper, a change of clothes, simple food or coffee items and a few basic tools.'},{q:'Should the first-night box go in the moving truck?',a:'It can, but load it last so it is easy to access. Important documents, medication, keys and valuables are better kept with you.'},{q:'How many first-night boxes do I need?',a:'A personal overnight bag for each person plus one shared household essentials box is usually easier than one oversized box for everything.'}];
---
<StandaloneGuide slug="first-night-box-moving-checklist" category="moving" title="First Night Box Checklist | What to Pack for Moving Day" description="A practical first-night moving box checklist covering toiletries, chargers, medication, cleaning basics, tools, breakfast items and what to keep with you." h1="What to pack in a first-night box so you do not unpack the whole house on moving day." intro="The first night in a new home is usually more functional than glamorous. You need to shower, charge your phone, find medication, make coffee and get through the morning without digging through a wall of boxes. A deliberately small essentials kit solves that." quickAnswer="Pack one overnight bag per person plus one shared household essentials box. Keep documents, medication, keys and valuables with you, and load the household box last so it comes off first." relatedDownload="moving-planner-printable" relatedLabel="Moving Planner Printable" {sections} {checklist} {mistakes} {faqs} relatedGuides={[{href:'/guides/moving-checklist-8-weeks/',label:'8-week moving checklist'},{href:'/guides/how-to-label-moving-boxes/',label:'How to label moving boxes'}]} />
